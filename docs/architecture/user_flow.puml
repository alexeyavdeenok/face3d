
@startuml
title User Flow — Face3D

start

:Запуск приложения;
:Открыть главный экран;

if (Действие пользователя?) then (Загрузка фотографии)

    :Добавить одну или несколько фотографий;
    :Проверить загруженные изображения;
    :Отобразить фотографии на главном экране;

    if (Открыть фотографию?) then (Да)
        :Открыть увеличенный просмотр;
        :Выполнить обрезку при необходимости;
        :Применить изменения или вернуться;
    endif

    :Настроить параметры генерации;
    :Нажать «Сгенерировать»;

    if (Есть загруженные фотографии?) then (Да)

        :Перейти на экран генерации;
        :Запустить обработку;

        if (Пользователь отменяет?) then (Да)
            :Отправить запрос на отмену;
            :Остановить обработку;
            :Вернуться на главный экран;
        else (Нет)
            if (Генерация успешна?) then (Да)
                :Сохранить результат;
                :Перейти на главный экран;
                :Отобразить состояние успешной обработки;
                :Предоставить просмотр, экспорт и удаление;
            else (Нет)
                :Зафиксировать неудачную попытку;
                :Перейти на главный экран;
                :Отобразить сообщение об ошибке;
            endif
        endif

    else (Нет)
        :Показать сообщение об отсутствии фотографий;
        :Остаться на главном экране;
    endif

elseif (История)

    :Открыть экран истории;
    :Загрузить все попытки реконструкции;
    :Отобразить таблицу;

    :При необходимости применить фильтр или сортировку;

    if (Пользователь выбирает запись?) then (Да)
        :Отобразить действия для записи;

        if (Действие?) then (Просмотр)
            if (Результат существует?) then (Да)
                :Открыть модель в браузере;
            else (Нет)
                :Сообщить об отсутствии результата;
            endif
        elseif (Экспорт)
            if (Результат существует?) then (Да)
                :Открыть системное окно сохранения;
                :Экспортировать модель;
            else (Нет)
                :Сообщить об отсутствии результата;
            endif
        else (Удаление)
            :Запросить подтверждение;

            if (Подтверждено?) then (Да)
                :Удалить запись и связанные результаты;
                :Обновить таблицу;
            else (Нет)
                :Отменить удаление;
            endif
        endif
    endif

    :Нажать «Назад»;
    :Вернуться в последнее состояние главного экрана;

else (Настройки)
    :Изменить параметры генерации;
    :Остаться на главном экране;
endif

stop
@enduml
