@startuml
!include <C4/C4_Context>

title System Context — Face3D Studio

Person(user, "Пользователь", "3D-художник / дизайнер / разработчик игр")

System(app, "Face3D Studio", "Десктопное приложение для автоматической реконструкции лица по фотографиям в текстурированную 3D-модель")

System_Ext(api, "Inference API", "Удалённый ML-сервис: FastAPI + GPU + модель")
