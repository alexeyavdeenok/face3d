
@startuml
!include <C4/C4_Container>

title Container — Face3D Studio

Person(user, "Пользователь")

System_Boundary(face3d, "Face3D Studio") {

    Container(qml, "QML Views", "PySide6 / Qt Quick", "Отображение экранов и компонентов интерфейса")

    Container(controllers, "UI Controllers", "Python / PySide6", "Обработка действий пользователя и управление представлениями")

    Container(api, "Application API", "Python", "Публичные операции приложения")

    Container(generationApi, "Generation API", "Python", "Запуск, отмена и получение состояния реконструкции")

    Container(historyApi, "History API", "Python", "Получение, фильтрация и удаление истории")

    Container(exportApi, "Export API", "Python", "Экспорт результатов реконструкции")

    Container(previewApi, "Preview API", "Python", "Открытие и закрытие предпросмотра модели")

    Container(settingsApi, "Settings API", "Python", "Получение и изменение настроек")

    Container(services, "Application Services", "Python", "Оркестрация прикладных сценариев")

    Container(reconstructionService, "ReconstructionService", "Python", "Управление процессом реконструкции")

    Container(router, "BackendRouter", "Python", "Выбор подходящего backend")

    Container(remote, "RemoteBackend", "Python", "Взаимодействие с удалённым сервисом")

    Container(local, "LocalBackend", "Python", "Локальное выполнение реконструкции")

    Container(repository, "JobRepository", "Python", "Хранение и получение заданий")

    Container(exporter, "MeshExporter", "Python", "Экспорт трёхмерной модели")

    Container(viewer, "MeshViewer", "Python / Qt", "Предпросмотр трёхмерной модели")
}

ContainerDb(db, "Database", "SQLite", "История реконструкций, настройки и метаданные")

System_Ext(storage, "Object Storage", "S3 / MinIO", "Хранение исходных фотографий и результатов")

System_Ext(inference, "Inference Service", "FastAPI", "Удалённое выполнение ML-модели")

Container(depthModel, "FaceDepthModel", "PyTorch", "Получение карты глубины лица")

Container(meshReconstructor, "MeshReconstructor", "trimesh / Open3D", "Построение трёхмерной сетки")

Rel(user, qml, "Взаимодействует с интерфейсом")
Rel(qml, controllers, "Сигналы, свойства и слоты")
Rel(controllers, api, "Вызывает операции приложения")

Rel(api, generationApi, "Запросы генерации")
Rel(api, historyApi, "Запросы истории")
Rel(api, exportApi, "Запросы экспорта")
Rel(api, previewApi, "Запросы предпросмотра")
Rel(api, settingsApi, "Запросы настроек")

Rel(generationApi, services, "Передаёт команды")
Rel(historyApi, repository, "Получает историю")
Rel(exportApi, exporter, "Передаёт модель на экспорт")
Rel(previewApi, viewer, "Передаёт модель на просмотр")

Rel(services, reconstructionService, "Запускает сценарий реконструкции")
Rel(reconstructionService, router, "Передаёт задачу")
Rel(router, remote, "Выбирает удалённый backend")
Rel(router, local, "Выбирает локальный backend")

Rel(remote, inference, "Отправляет фотографии и получает результат")
Rel(local, depthModel, "Получает карту глубины")
Rel(local, meshReconstructor, "Строит трёхмерную сетку")

Rel(reconstructionService, repository, "Сохраняет состояние задания")
Rel(repository, db, "Читает и записывает данные")

Rel(exporter, storage, "Сохраняет результат")
Rel(reconstructionService, storage, "Сохраняет и загружает файлы")
Rel(qml, storage, "Выбирает исходные фотографии")

@enduml
